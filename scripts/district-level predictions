title: "Generate spatial grid for data"
author: "Millicent Opoku"
date: "10/04/2026"


Aim: To generate spatial grid to overlay on Ghana map


## InstallLoad and libraries
packages <- c("brms", "dplyr", "ggplot2", "patchwork", "ggnewscale", "tidyr")

# Install missing ones
installed <- packages %in% installed.packages()[, "Package"]
if (any(!installed)) {
  install.packages(packages[!installed])
}

# Load all
lapply(packages, library, character.only = TRUE)



### Predictions for disttricts

##Regenerate posterior draws for the prediction grid
# This may take several minutes depending on grid size and draws
pred_grid_draws <- posterior_epred(
  fit_v8,
  newdata          = pred_grid,
  
  re_formula       = NA,
  allow_new_levels = TRUE,
  sample_new_levels ="gaussian",
  ndraws           = 1000
  
)
##Adjust crs to match your coordinate system if not already in 32630
pred_grid_sf <- pred_grid %>%
  st_as_sf(coords = c("easting", "northing"), crs = 32630)

## Load Ghana shapefile
ghana_districts <- st_read("data/ghana_districts.shp")
# Sanity checks
## check if boundaries overlap
st_bbox(ghana_districts)
   #  xmin      ymin      xmax      ymax 
# 471032.4  523854.8  965101.3 1236683.2 
st_bbox(pred_grid_sf)
  # xmin    ymin    xmax    ymax 
 # 476776  551797  896776 1226797 

## Join districts to prediction grid
pred_grid_sf <- st_join(pred_grid_sf,
                        ghana_districts["NAME_2"],
                        join = st_intersects) %>%
                        rename(district = NAME_2) # rename NAME_2 to district

#Check if all data points have been assigned districts and there is none missing
sum(!is.na(pred_grid_sf$districts))

## Extract districts
grid_districts <- pred_grid_sf$district

##Extract years
grid_years     <- pred_grid_sf$year

## Combine districts and years
combos <- unique(data.frame(
   district = grid_districts,
   year     = grid_years,
   stringsAsFactors = FALSE
 ))

## Prepare a results container
 results <- vector("list", nrow(combos))
 for (i in seq_len(nrow(combos))) {                         # Loop through each district–year
   d <- combos$district[i]
   y <- combos$year[i]
   
   cols <- which(grid_districts == d & grid_years == y)      # Identifies relevant grid cells
   
   # Average across grid points within district for each draw
   if (length(cols) == 1) {
     draw_vals <- pred_grid_draws[, cols]          # 1000 draws         #Extract model predictions for only one grid cell
   } else {
     draw_vals <- rowMeans(pred_grid_draws[, cols]) # 1000 spatial means # Extract model predictions for multiple grid cells
   }

## Generate district-level statistics
   results[[i]] <- data.frame(
     district   = d,
     year       = y,
     mean_prev  = mean(draw_vals)             / 133,
     lower_prev = quantile(draw_vals, 0.025)  / 133,
     upper_prev = quantile(draw_vals, 0.975)  / 133
  )
}

## Combine all the results
district_prev <- bind_rows(results)

## Check for one of the districts
 district_prev %>%
   filter(district == "Bole") %>%
   arrange(year) %>%
   mutate(estimate = paste0(
     round(mean_prev * 100, 1), "% (",
     round(lower_prev * 100, 1), "–",
     round(upper_prev * 100, 1), "%)"
   )) %>%
   select(year, estimate)


## print all districts summaries to an object
district_prev <- district_prev %>%
   filter(year %in% c(1975, 1980, 1990, 2000, 2010, 2015, 2025, 2030, 2040)) %>%
   mutate(
     estimate = paste0(
       round(mean_prev * 100, 1), "% (",
       round(lower_prev * 100, 1), "–",
       round(upper_prev * 100, 1), "%)"
     )
   ) %>%
   select(district, year, estimate) %>%
   pivot_wider(names_from = year, values_from = estimate) %>%
   arrange(desc(`2030`)) %>% #select which year to arrange by
   data.frame() %>%
   write.table(stdout(), sep = "\t", row.names = FALSE, quote = FALSE)

## Save district prevalence file
write.csv (district_prev, "district_prev.csv")

